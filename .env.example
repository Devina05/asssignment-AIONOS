# Copy to agent_config.json (or export as environment variables).
# agent_config.json is gitignored and must never be committed.

SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_KEY=<your-supabase-service-role-key>
SUPABASE_TABLE=app_users
SESSION_TTL=28800
ALLOWED_DOMAIN=veridian-corp.example
IT_EMAILS=you@veridian-corp.example,other.it@veridian-corp.example
FINANCE_EMAILS=finance@veridian-corp.example
ADMIN_EMAILS=admin@veridian-corp.example